generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // Runtime queries lewat pooler (serverless).
  url       = env("DATABASE_URL")
  // prisma db push / migrate harus lewat koneksi langsung, bukan pooler.
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  phone     String?
  password  String
  role      String   @default("CUSTOMER") // CUSTOMER | ADMIN
  createdAt DateTime @default(now())
  orders    Order[]
}

// Fields mirror what POST /api/orders writes. `items` is stored as a JSON string
// ([{ name, qty, price }]) rather than a child table, which is how the UI reads it.
model Order {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  orderNumber  String          @unique
  service      String // KILOAN | SATUAN
  washType     String          @default("LAUNDRY") // LAUNDRY | DRY_CLEAN (kolom tarif di struk)
  status       String          @default("PENDING") // see ORDER_STATUSES in lib/data.ts
  deliveryType String // PICKUP | DELIVERY
  deliveryFee  Float           @default(0)
  items        String          @default("[]") // JSON: [{ name, qty, price }]
  weight       Float?
  total        Float           @default(0)
  notes        String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  statusLogs   OrderStatusLog[]
}

model OrderStatusLog {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    String
  note      String   @default("")
  createdAt DateTime @default(now())
}

model Expense {
  id          String   @id @default(cuid())
  description String
  amount      Float
  category    String   @default("OPERASIONAL") // OPERASIONAL|BAHAN|GAJI|LAINNYA
  date        DateTime @default(now())
}

// Daftar tarif dari struk cetak Rossy. Harga per potong.
// null = sel tarif memang kosong di struk (Karpet, Kasur Lantai) -> tidak bisa dipesan online.
model PriceItem {
  id            String   @id @default(cuid())
  category      String // PAKAIAN | RUMAH_TANGGA (tabel kiri / kanan di struk)
  name          String
  laundryPrice  Int?
  dryCleanPrice Int?
  note          String?
  sortOrder     Int      @default(0)
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([category, name])
  @@index([category, sortOrder])
}
